<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>boxkit</AssemblyName>
    <RootNamespace>Mp4BoxKit.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>boxkit</ToolCommandName>
    <PackageId>Mp4BoxKit.Cli</PackageId>
    <Version>0.1.0</Version>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Mp4BoxKit/Mp4BoxKit.csproj" />
    <ProjectReference Include="../Mp4BoxKit.Inspection/Mp4BoxKit.Inspection.csproj" />
  </ItemGroup>
</Project>
