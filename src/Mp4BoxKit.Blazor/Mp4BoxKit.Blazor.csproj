<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <RootNamespace>Mp4BoxKit.Blazor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Mp4BoxKit/Mp4BoxKit.csproj" />
    <ProjectReference Include="../Mp4BoxKit.Inspection/Mp4BoxKit.Inspection.csproj" />
  </ItemGroup>

  <Target Name="CopyCustomContent" AfterTargets="PrepareForBuild">
    <Copy SourceFiles="../../demo/app.js" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot" />
    <Copy SourceFiles="../../demo/styles.css" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot" />
  </Target>

</Project>
